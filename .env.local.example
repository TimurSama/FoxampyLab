# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата для отправки сообщений (можно получить у @userinfobot)
NEXT_PUBLIC_TELEGRAM_CHAT_ID=your_chat_id_here

# Google Analytics (будет добавлено позже)
NEXT_PUBLIC_GA_ID=your_ga_id_here

# Яндекс Метрика (будет добавлено позже)
NEXT_PUBLIC_YM_ID=your_ym_id_here