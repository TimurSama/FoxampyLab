{
  "name": "foxampy-lab",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@foxampy/website",
    "build": "npm run build --workspace=@foxampy/website",
    "start": "npm run start --workspace=@foxampy/website",
    "find-investors": "tsx scripts/find-investors.ts",
    "find-investors:watch": "tsx watch scripts/find-investors.ts",
    "bot": "npm run bot --workspace=@foxampy/website",
    "bot:dev": "npm run bot:dev --workspace=@foxampy/website"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
